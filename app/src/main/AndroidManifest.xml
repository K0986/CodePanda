<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USB Host / OTG is required to talk to a connected device -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Foreground service is used to keep an active mirroring / transfer session alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".CodePandaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodePanda"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.CodePanda">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launched automatically when a compatible USB device is attached -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!--
          The `connectedDevice` type's runtime prerequisite is satisfied by the
          USB device grant we obtain through UsbManager.requestPermission()
          before the service is ever started; lint only models the Bluetooth /
          NFC / network routes to that same permission gate.
        -->
        <service
            android:name=".core.session.SessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            tools:ignore="ForegroundServicePermission" />

    </application>

</manifest>
